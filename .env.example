# =====================================================================
# Вайбик — переменные окружения. Скопируй в .env.local (локально) или
# впиши в Vercel → Project → Settings → Environment Variables.
#
# НИЧЕГО НЕ ЗАДАНО = ДЕМО-РЕЖИМ: тестовый вход, прогресс в браузере,
# ИИ-симуляция, без оплаты. `npm run dev` работает без этого файла.
#
# VITE_*  — попадают в БРАУЗЕР (видны всем). Только публичные значения!
# без VITE_ — только сервер (/api на Vercel). Секреты — только сюда.
# Подробная инструкция: SETUP.md
# =====================================================================

# ---------------------------------------------------------------- Браузер (публичное)
# Supabase → Project Settings → API Keys → Project URL и Publishable key (sb_publishable_…)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Где живёт /api. Пусто = тот же домен (Vercel или `vercel dev`). Пример: https://vaibik.vercel.app
VITE_API_BASE=

# ИИ-проверка домашек через /api/ai/review. Включена автоматически при настроенном Supabase; 'false' — выключить.
VITE_AI_ENABLED=

# Оплата Pro через Polar и пейвол разделов 2–5. 'true' — включить (нужны серверные POLAR_* ниже).
VITE_BILLING_ENABLED=

# Режим ревью: все тиры открыты, пейвол не показывается. По умолчанию 'true'.
# ПЕРЕД ЗАПУСКОМ ДЛЯ ЛЮДЕЙ поставь 'false'.
VITE_REVIEW_MODE=true

# PostHog — продуктовая аналитика. Project API key (phc_…) публичный по замыслу. Пусто — аналитика выключена.
# PostHog → Project settings → Project API key / Project region (US: https://us.i.posthog.com, EU: https://eu.i.posthog.com)
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com
# Запись сессий (все поля и тексты маскируются). По умолчанию выключена; 'true' — включить.
VITE_POSTHOG_SESSION_RECORDING=

# Sentry — ошибки в браузере. DSN публичный по замыслу. Пусто — выключено.
# Sentry → проект vaibik-web → Settings → Client Keys (DSN)
VITE_SENTRY_DSN=
# необязательно: production / preview (по умолчанию production в сборке, development в dev)
VITE_SENTRY_ENVIRONMENT=

# Отзывы: отправлять на /api/feedback. Включено автоматически при Supabase; 'true' — без Supabase
# (только пересылка в FEEDBACK_WEBHOOK_URL), 'false' — хранить отзывы только в браузере.
VITE_FEEDBACK_API=

# ---------------------------------------------------------------- Сервер (секретно)
# Публичный адрес сайта — для ссылок возврата из оплаты и проверки Origin
APP_URL=

# Supabase → Project Settings → API Keys → тот же Project URL и Secret key (sb_secret_…). НИКОГДА не с VITE_!
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# DeepSeek → platform.deepseek.com → API keys
DEEPSEEK_API_KEY=
# необязательно:
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Лимит ИИ-проверок в сутки (UTC) на ученика
AI_DAILY_LIMIT_FREE=10
AI_DAILY_LIMIT_PRO=100

# Polar → Settings → Developers → New Token (скоупы checkouts:write, customer_sessions:write)
POLAR_ACCESS_TOKEN=
# sandbox (тест, карта 4242 4242 4242 4242) или production (реальные деньги)
POLAR_SERVER=sandbox
# id продуктов Pro (Products → … → Copy ID). В sandbox и production id РАЗНЫЕ.
POLAR_PRODUCT_MONTHLY_ID=
POLAR_PRODUCT_ANNUAL_ID=
# Polar → Settings → Webhooks → секрет эндпоинта https://<сайт>/api/billing/webhook
POLAR_WEBHOOK_SECRET=
# необязательно: версия API Polar (заголовок Polar-Version)
POLAR_API_VERSION=2026-10

# ---------------------------------------------------------------- Наблюдаемость и отзывы (сервер)
# Sentry для /api (можно отдельный проект vaibik-api). Пусто — ошибки только в логах Vercel.
SENTRY_DSN=
# необязательно: по умолчанию VERCEL_ENV (production / preview)
SENTRY_ENVIRONMENT=

# Пересылка отзывов в чат (секрет — содержит токен бота!). Поддерживаются:
#   Telegram: https://api.telegram.org/bot<TOKEN>/sendMessage?chat_id=<CHAT_ID>
#   Discord:  https://discord.com/api/webhooks/…      Slack: https://hooks.slack.com/services/…
# Пусто — отзывы только в таблице feedback (Supabase).
FEEDBACK_WEBHOOK_URL=
