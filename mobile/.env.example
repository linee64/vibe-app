# Все значения публичные: они попадают в приложение. Секреты сервера (DEEPSEEK, service role,
# ключи Polar) сюда НЕ кладём — приложение ходит только в свой бэкенд /api.

# Supabase (publishable-ключ, начинается с sb_publishable_ или eyJ с ролью anon)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Где живёт веб-бэкенд (Vercel), без слэша на конце. Пусто — ИИ-проверка домашек идёт офлайн.
EXPO_PUBLIC_API_BASE=

# Режим ревью: всё открыто, пейвол не мешает. Перед релизом поставь false.
EXPO_PUBLIC_REVIEW_MODE=true

# RevenueCat (публичные SDK-ключи). Нужен dev build, в Expo Go покупки недоступны.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=

# PostHog — аналитика воронки (ключ проекта phc_… публичный по замыслу). Пусто — аналитика выключена.
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Sentry — отчёты об ошибках (DSN публичный по замыслу). Пусто — выключено.
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_SENTRY_ENVIRONMENT=
# Только для выгрузки source maps в EAS Build (не EXPO_PUBLIC_!). SENTRY_AUTH_TOKEN храни как секрет EAS.
# SENTRY_ORG=
# SENTRY_PROJECT=
